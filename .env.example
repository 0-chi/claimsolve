# ===========================================================================
# クレソル(ClaimSolve)環境変数サンプル
# APIキーが1つも無くても全機能がモックで動作します。
# 本番の各サービスに差し替える場合のみ値を設定してください。
# ===========================================================================

# データベース(開発=SQLite / 本番=PostgreSQL互換)
DATABASE_URL="file:./dev.db"

# アプリのベースURL(マジックリンク・OGP生成に使用)
APP_URL="http://localhost:3000"

# admin Basic認証(第9章)
ADMIN_USER="admin"
ADMIN_PASS="claimsolve"

# --- 外部サービス(第12章 差し替え表)---------------------------------------
# 未設定ならモック実装が使われます。

# SMS認証(モック=コード123456固定 / 本番=Twilio等)
SMS_API_KEY=""

# eKYC・任意機能(モック=3秒後に自動承認 / 本番=TRUSTDOCK等)
KYC_API_KEY=""

# 決済(モック=常に成功 / 本番=Stripe)
STRIPE_SECRET_KEY=""

# メール送信(モック=コンソール出力+EmailLog / 本番=Resend/SES)
MAIL_API_KEY=""

# 投稿審査(モック=正規表現+辞書 / 本番=Claude API)
ANTHROPIC_API_KEY=""

# 法人マスタ(モック=シード100社検索 / 本番=国税庁 法人番号Web-API)
HOJIN_APP_ID=""

# --- 計測(v1.5 §7。未設定なら読み込まない)---------------------------------
# GA4 測定ID(例: G-XXXXXXXXXX)。有効化時はプライバシーポリシーの外部送信記載を最新化
NEXT_PUBLIC_GA_ID=""
# Google Search Console のHTML確認タグ(content値)
NEXT_PUBLIC_GSC_VERIFICATION=""
