# ===========================================================================
# クレソル(ClaimSolve)環境変数サンプル
# APIキーが1つも無くても全機能がモックで動作します。
# 本番の各サービスに差し替える場合のみ値を設定してください。
# ===========================================================================

# データベース
# 開発/デモ = SQLite。本番 = PostgreSQL の接続文字列(postgres://〜)を設定すると
# ビルド・実行が自動で「本番モード」に切り替わる(scripts/vercel-build.mjs)。
DATABASE_URL="file:./dev.db"

# アプリのベースURL(マジックリンク・OGP生成に使用)。本番では https://ドメイン を設定
APP_URL="http://localhost:3000"

# admin Basic認証(第9章)。本番では必ず初期値から変更(未変更だとビルドが止まる)
ADMIN_USER="admin"
ADMIN_PASS="claimsolve"

# セッションCookieの署名鍵(本番必須・16文字以上のランダム文字列)
# 生成例: openssl rand -base64 32
SESSION_SECRET=""

# --- 外部サービス(第12章 差し替え表)---------------------------------------
# 未設定ならモック実装が使われます。

# SMS認証(モック=コード123456固定 / 本番=Twilio Verify)
# 3つすべて設定すると Twilio Verify に切替(番号購入不要・従量課金)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
# (旧キー・現在未使用)
SMS_API_KEY=""

# eKYC・任意機能(モック=3秒後に自動承認 / 本番=TRUSTDOCK等)
KYC_API_KEY=""

# 決済(モック=常に成功 / 本番=Stripe)
STRIPE_SECRET_KEY=""

# メール送信(モック=コンソール出力+EmailLog / 本番=Resend)
# MAIL_API_KEY に Resend のAPIキー(re_〜)を設定すると実送信に切替
MAIL_API_KEY=""
# 送信元(Resendでドメイン認証したアドレス)。例: ClaimSolve <noreply@example.com>
MAIL_FROM=""

# 投稿審査(モック=正規表現+辞書 / 本番=Claude API)
# キーを設定すると「正規表現 → Claude追加審査」の2段構えに切替
ANTHROPIC_API_KEY=""
# 審査に使うモデル(省略時: claude-haiku-4-5-20251001)
ANTHROPIC_MODERATION_MODEL=""

# 法人マスタ(モック=シード100社検索 / 本番=国税庁 法人番号Web-API)
HOJIN_APP_ID=""

# --- 計測(v1.5 §7。未設定なら読み込まない)---------------------------------
# GA4 測定ID(例: G-XXXXXXXXXX)。有効化時はプライバシーポリシーの外部送信記載を最新化
NEXT_PUBLIC_GA_ID=""
# Google Search Console のHTML確認タグ(content値)
NEXT_PUBLIC_GSC_VERIFICATION=""

# サポートページに表示するお問い合わせメールアドレス(設定すると「準備中」表記が消える)
NEXT_PUBLIC_CONTACT_EMAIL=""
